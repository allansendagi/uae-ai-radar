# Copy this file to ".env" (same folder) and fill in real values yourself.
# Claude never sees or enters these values — you fill this in directly.

# Apify API token — from https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Anthropic API key — from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gmail address the digest is sent FROM (needs an app password, not your normal password)
GMAIL_ADDRESS=allansendagi@gmail.com

# Gmail app password — generate at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account first)
GMAIL_APP_PASSWORD=

# Where the digest is sent TO — defaults to GMAIL_ADDRESS if left blank
DIGEST_TO_EMAIL=allansendagi@gmail.com

# Optional — from https://newsapi.org/. Second, independent news source
# (official API, not scraping) run alongside Apify, not instead of it.
# Pipeline works fine without this; leave blank to skip it.
NEWSAPI_KEY=
